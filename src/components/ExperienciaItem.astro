---
interface Props {
    date: string
    description: string
    title: string
    
}
const  {title, date, description} = Astro.props
---

        <time class="text-xs md:text-sm font-extrabold text-violet-400">{date}</time>
        <h3 class="text-base md:text-lg font-semibold text-heading text-violet-800 my-2">{title}</h3>
        <p class="mb-4 text-xs md:text-sm text-gray-800">{description}</p>
     