---
const columnas = [
  [
    {
      img: "/topical_authority_analycer.webp",
      link: "/seo",
      alt: "Topical Authority Analyzer",
    },
    {
      img: "/proyecto_ias.webp", // Debe estar en la carpeta /public
      link: "/seo-fixer",     // Puede ser interna (/proyecto) o externa (https://...)
      alt: "Quick SEO Fixer",
    },
  ],
];
---

<section class="galeria">
  {
    columnas.map((columna) =>
      columna.map((proyecto) => (
        <a href={proyecto.link} target="_blank" rel="noopener noreferrer">
          <img
            src={proyecto.img}
            alt={proyecto.alt}
            class="proyecto-img"
          />{" "}
        </a>
      )),
    )
  }
</section>

<style>
.proyecto-img {
    max-width: 190px; 
    width: 100%;
    height: auto;
    opacity: 0.85; 
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .proyecto-img:hover {
    transform: scale(1.02);
  }

  .galeria {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: flex-start;
  }
</style>