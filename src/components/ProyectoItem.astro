---
const columnas = [
  [
    {
      img: "/topical_authority_analycer.jpeg",
      link: "/seo",
      alt: "Topical Authority Analyzer",
      titulo: "Calcula la autoridad por clúster temático"
    },
  ],
];
---

<section class="galeria">
  {
    columnas.map((columna) =>
      columna.map((proyecto) => (
        <a href={proyecto.link} target="_blank" rel="noopener noreferrer" class="proyecto-item">
          {proyecto.titulo && (
            <h2 class="proyecto-titulo">{proyecto.titulo}</h2>
          )}
          <img
            src={proyecto.img}
            alt={proyecto.alt}
            class="proyecto-img"
          />

        </a>
      ))
    )
  }
</section>

<style>
.proyecto-item {
    display: flex;
    flex-direction: column;
    align-items: center; /* <-- Esto centra horizontalmente todo lo que esté dentro (imagen y título) */
    text-decoration: none;
  }

  .proyecto-img {
    max-width: 150px;
    width: 100%;
    height: auto;
    opacity: 0.7;
    border-radius: 10px;
    object-fit: cover;
    transition: transform 0.2s ease;
    margin: 0 auto; /* <-- Asegura que la imagen se centre perfectamente */
  }

  .proyecto-img:hover {
    transform: scale(1.02);
  }

  .proyecto-titulo {
    color: #1f2937;
    font-size: 0.75rem;
    margin-top: 0.5rem;
    font-weight: 600;
    text-align: center;
  }

  .galeria {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: space-between;
  }
</style>
