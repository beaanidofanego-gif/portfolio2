---
interface Item {
    img: string;
    link: string;
    alt: string;
    titulo?: string; // Opcional (?) para evitar errores si algún elemento no lo tiene
}

interface Props {
    columnas: Item[][];
}

const { columnas } = Astro.props;

// Optimizamos calculando el flat() una sola vez en el frontmatter
const items = columnas.flat();
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
  {items.map((item) => (
    <a
      href={item.link}
      target="_blank"
      rel="noopener noreferrer"
      class="block break-inside-avoid group"
    >
      <img
        src={item.img}
        alt={item.alt}
        loading="lazy"
        class="w-full rounded-xl mb-2 grayscale group-hover:grayscale-0 group-hover:scale-105 transition duration-300"
      />
      
      {item.titulo && (
        <h2 class="text-white font-medium text-base tracking-wide">{item.titulo}</h2>
      )}
    </a>
  ))}
</div>



